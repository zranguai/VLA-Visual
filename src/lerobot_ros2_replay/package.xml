<?xml version="1.0"?>
<package format="3">
  <name>lerobot_ros2_replay</name>
  <version>0.1.0</version>
  <description>Replay LeRobot v3 episodes as Lite robot ROS 2 topics.</description>
  <maintainer email="zme@example.com">zme</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>arm_interfaces</exec_depend>
  <exec_depend>custom_image_msg</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rclpy</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
